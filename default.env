# Membership Service
REDIS_HOST=redis
PAYMENT_CLIENT_URL=http://localhost:8083/payments

# PostgreSQL
POSTGRES_URL="jdbc:postgresql://localhost:${POSTGRES_PORT}/membership-service"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=membership-service

# Redis
REDIS_PASSWORD=root123
REDIS_USER=my_user
REDIS_USER_PASSWORD=my_user_password

# Apache Kafka
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_BOOTSTRAP_SERVERS="localhost:${KAFKA_PORT}"